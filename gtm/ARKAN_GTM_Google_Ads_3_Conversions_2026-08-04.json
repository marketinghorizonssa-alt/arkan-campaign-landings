            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function(w,d){\n  if(w.__arkanGtmListenerInstalled)return;\n  w.__arkanGtmListenerInstalled=true;\n  var last={};\n  function emit(name,data,key){\n    var now=Date.now(),k=key||name;\n    if(last[k]&&now-last[k]<1000)return;\n    last[k]=now;\n    w.dataLayer=w.dataLayer||[];\n    var payload={event:name,page_path:w.location.pathname};\n    data=data||{};\n    for(var p in data){if(Object.prototype.hasOwnProperty.call(data,p))payload[p]=data[p];}\n    w.dataLayer.push(payload);\n  }\n  d.addEventListener('click',function(e){\n    var node=e.target;\n    var a=node&&node.closest?node.closest('a'):null;\n    if(!a)return;\n    var href=(a.getAttribute('href')||'').trim();\n    var text=(a.textContent||'').replace(/\\s+/g,' ').trim();\n    if(/^tel:/i.test(href)){\n      emit('click_call',{click_url:href,click_text:text},'call:'+href);\n      return;\n    }\n    if(/(?:wa\\.me|api\\.whatsapp\\.com|whatsapp\\.com)/i.test(href)){\n      emit('click_whatsapp',{click_url:href,click_text:text},'wa:'+href);\n    }\n  },true);\n  d.addEventListener('arkan:lead-success',function(e){\n    var x=e&&e.detail?e.detail:{};\n    emit('lead_form_success',{\n      landing_page_id:x.landing_page_id||'',\n      lead_token:x.lead_token||'',\n      duplicate:!!x.duplicate\n    },'form:'+(x.lead_token||'success'));\n  });\n})(window,document);\n</script>"
