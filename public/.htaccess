Options -Indexes
DirectoryIndex index.php

<IfModule mod_setenvif.c>
SetEnvIf Origin "^https://(www\.)?arkan2030\.com$" ARKAN_CORS_ORIGIN=$0
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Keep one canonical hostname for the official website.
RewriteCond %{HTTP_HOST} ^www\.arkan2030\.com$ [NC]
RewriteRule ^ https://arkan2030.com%{REQUEST_URI} [R=301,L,NE]

# Complete the official-domain form preflight without invoking PHP.
RewriteCond %{REQUEST_URI} ^/api/lead$
RewriteCond %{REQUEST_METHOD} =OPTIONS
RewriteRule ^ - [R=204,L]

# Serve physical SEO control files directly. All application pages fall through to PHP.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Allow only the official ARKAN domain to submit to the existing lead backend.
Header always set Access-Control-Allow-Origin "%{ARKAN_CORS_ORIGIN}e" env=ARKAN_CORS_ORIGIN
Header always set Access-Control-Allow-Methods "POST, OPTIONS" env=ARKAN_CORS_ORIGIN
Header always set Access-Control-Allow-Headers "Content-Type, Accept" env=ARKAN_CORS_ORIGIN
Header always merge Vary "Origin" env=ARKAN_CORS_ORIGIN

<Files "robots.txt">
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header always set Content-Type "text/plain; charset=utf-8"
</Files>

<Files "sitemap.xml">
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header always set Content-Type "application/xml; charset=utf-8"
</Files>

<FilesMatch "\.(css|js|webp|webm|png|jpg|jpeg|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/csv
</IfModule>
