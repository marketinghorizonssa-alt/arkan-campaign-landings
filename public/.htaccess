Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Serve physical SEO control files directly. All application pages fall through to PHP.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

<Files "robots.txt">
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header always set Content-Type "text/plain; charset=utf-8"
</Files>

<Files "sitemap.xml">
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header always set Content-Type "application/xml; charset=utf-8"
</Files>

<FilesMatch "\.(css|js|webp|webm|png|jpg|jpeg|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/csv
</IfModule>
